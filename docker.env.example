# Koleya — Variables d'environnement Docker
# Copier ce fichier en .env.docker puis lancer :
#   docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.staging.yml up -d --build   (staging)
#   docker compose --env-file .env.docker -f docker-compose.yml -f docker-compose.prod.yml up -d --build     (prod VPS)

# Base de données
DB_USER=koleya
DB_PASSWORD=CHANGEZ-MOI-MOT-DE-PASSE
DB_NAME=koleya

# JWT — GÉNÉRER un secret fort : openssl rand -hex 32
JWT_SECRET=CHANGEZ-MOI-SECRET-JWT

# Origine autorisée pour CORS (ports dev + site)
CORS_ORIGIN=http://localhost:8080,http://localhost:5174,http://localhost:5173

# Domaine (prod uniquement, pour Caddy auto-HTTPS)
DOMAIN=koleyaapp.cm
