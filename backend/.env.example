# Koleya Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
#
# ⚠️ PRODUCTION : ne jamais démarrer avec les valeurs par défaut ci-dessous.
# Le serveur refuse de démarrer si JWT_SECRET manque ou vaut "koleya-dev-secret".

# Serveur
PORT=3001
NODE_ENV=development

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=koleya
DB_USER=koleya
DB_PASSWORD=votre_mot_de_passe
# Taille du pool (30 convient pour ~100 utilisateurs simultanés)
DB_POOL_MAX=30
# Activer si la base est distante (prod) : DB_SSL=true

# JWT — générer un secret fort : openssl rand -hex 32
JWT_SECRET=koleya-dev-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS — origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# URLs de l'application (pour les callbacks paiement)
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# =============================================
# PAIEMENTS — CinetPay (Principal)
# https://docs.cinetpay.com
# =============================================
CINETPAY_APP_ID=
CINETPAY_API_KEY=
CINETPAY_SITE_ID=

# =============================================
# PAIEMENTS — Flutterwave (Backup)
# https://developer.flutterwave.com
# =============================================
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
