# Agent Environment Variables Template
#
# INSTRUCTIONS:
# 1. Copier ce fichier vers .env.agents.local
# 2. Remplir avec vos vraies valeurs
# 3. NE JAMAIS committer .env.agents.local
#
# ⚠️ SÉCURITÉ: Ces tokens donnent un accès complet à vos services

# ============================================
# GITHUB
# ============================================
GITHUB_OWNER=your-github-username
GITHUB_REPO=Koleya-ERP-PME-v1.0
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

# ============================================
# VERCEL
# ============================================
VERCEL_PROJECT_ID=prj_5MDabpICxLjcdVtCd0k42VgJcsoZ
VERCEL_TOKEN=vck_YOUR_TOKEN_HERE
VERCEL_ORG_ID=your-org-id

# ============================================
# SUPABASE
# ============================================
SUPABASE_PROJECT_ID=etkguxaroezjywrujfom
SUPABASE_SERVICE_ROLE_KEY=sbp_YOUR_TOKEN_HERE
SUPABASE_URL=https://etkguxaroezjywrujfom.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_READONLY_URL=postgresql://readonly_user:password@host:5432/database

# ============================================
# EMAIL (SendGrid ou Gmail)
# ============================================
SENDGRID_API_KEY=SG.YOUR_KEY_HERE
# OU
GMAIL_CLIENT_ID=your_client_id
GMAIL_CLIENT_SECRET=your_client_secret
GMAIL_REFRESH_TOKEN=your_refresh_token

# ============================================
# MONITORING & OBSERVABILITY
# ============================================
SENTRY_DSN=https://...@sentry.io/...
DATADOG_API_KEY=your_datadog_key
DATADOG_APP_KEY=your_datadog_app_key

# ============================================
# SLACK / DISCORD (Notifications)
# ============================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_BOT_TOKEN=xoxb-YOUR-TOKEN
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK

# ============================================
# AGENTS CONFIG
# ============================================
AGENT_MODE=production
AGENT_LOG_LEVEL=info
AGENT_AUTO_MERGE=false
AGENT_AUTO_DEPLOY=false
AGENT_REQUIRE_APPROVAL=true

# ============================================
# OPTIONAL: CLOUD PROVIDERS
# ============================================
# AWS
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=eu-west-1

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
